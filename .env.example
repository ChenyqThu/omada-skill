# omada-skill runtime configuration
#
# Copy to `.env.local` and fill in the values you need. `.env.local` is
# loaded automatically by the `dev:stdio` / `dev:http` / `start` npm
# scripts via Node's built-in `--env-file-if-exists` flag (Node 22+).
#
# All variables are optional; if OMADA_CLIENT_ID and OMADA_CLIENT_SECRET
# are unset the server falls back to MOCK mode for offline development.

# --- OAuth2 Client Credentials ------------------------------------------
OMADA_CLIENT_ID=
OMADA_CLIENT_SECRET=

# --- Controller targeting -----------------------------------------------
# Pick a region key from packages/sdk/src/client/regions.ts, or set
# OMADA_BASE_URL explicitly to override it (e.g. for self-hosted /
# on-prem controllers). OMADA_TOKEN_URL overrides the default
# `<baseUrl>/openapi/authorize/token` token endpoint.
OMADA_REGION=use1
# OMADA_BASE_URL=https://omada-central.example.com
# OMADA_TOKEN_URL=https://omada-central.example.com/openapi/authorize/token

# --- Runtime flags ------------------------------------------------------
# OMADA_DRY_RUN=1          # short-circuit every non-GET call with a plan preview

# --- Guardrails ---------------------------------------------------------
# High-entropy secret (>= 16 chars) mixed into confirm tokens. Required
# for any tool that calls `issueConfirmToken`. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# OMADA_MCP_CONFIRM_SECRET=

# --- Audit log (M2-05) --------------------------------------------------
# Directory for JSONL audit log files (`YYYY-MM-DD.jsonl`). When unset,
# audit events are delivered only to the in-process callback, matching
# the M1 behaviour.
# OMADA_AUDIT_DIR=~/.omada-mcp/audit
