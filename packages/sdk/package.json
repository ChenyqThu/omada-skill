{
  "name": "@omada/sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./operations": {
      "types": "./dist/generated/operations.d.ts",
      "default": "./dist/generated/operations.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b && node -e \"require('node:fs').copyFileSync('src/generated/schema.d.ts','dist/generated/schema.d.ts')\"",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:staging": "vitest run test/staging.test.ts --config vitest.staging.config.ts",
    "lint": "eslint src",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@omada/shared": "workspace:*"
  }
}
